# ========================================================================
# eflink-wiki 部署配置模板
#   用法：cp scripts/deploy.env.example scripts/deploy.env 填写真实值
#        然后运行 ./scripts/deploy-backend.sh / deploy-collab.sh /
#        deploy-frontend.sh / deploy-all.sh
#   说明：scripts/deploy.env 已加入 .gitignore（含服务器地址与密钥，切勿提交）
# ========================================================================

# ---- SSH 连接 ----
REMOTE_USER=root
REMOTE_HOST=your-server.example.com
REMOTE_PORT=22
# REMOTE_SSH_KEY=~/.ssh/id_rsa      # 如需指定私钥则取消注释（默认走 ssh-agent）

# ---- 后端 jar ----
REMOTE_JAR_PATH=/home/www/eflink-wiki/eflink-wiki-server.jar
REMOTE_PID_FILE=/home/www/eflink-wiki/.backend.pid
REMOTE_LOG_FILE=/home/www/eflink-wiki/backend.log
APP_PORT=8090
JAVA_OPTS="-Xmx1024m"                # 按服务器内存调整
SHUTDOWN_TIMEOUT=15                  # SIGTERM 后等待秒数，超时则 SIGKILL
HEALTH_MAX_WAIT=60                   # 启动健康检查最长等待秒数

# ---- 协同服务 collab-server ----
REMOTE_COLLAB_DIR=/home/www/eflink-wiki/collab-server
COLLAB_PORT=18080
COLLAB_PID_FILE=/home/www/eflink-wiki/.collab.pid
COLLAB_LOG_FILE=/home/www/eflink-wiki/collab.log
COLLAB_HEALTH_MAX_WAIT=20

# ---- 前端静态目录（nginx root） ----
REMOTE_FRONTEND_DIR=/home/www/eflink-wiki/dist

# ---- 数据库（MySQL 8.0+）----
# 不填则回退 application.yml 默认值（127.0.0.1:3306/eflink-wiki，root/123456）
# 生产建议使用独立的 MySQL 8.0 实例（RDS 等），先建库：
#   CREATE DATABASE `eflink-wiki` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 首次启动 Flyway 自动建全部表（V1→V7）
# 注意：URL 必须用引号包住（值里有 & 和 ?，裸写会被 shell 截断）
SPRING_DATASOURCE_URL='jdbc:mysql://your-rds-host:3306/eflink-wiki?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=''

# ---- 服务端环境变量（写入远端 wiki.env，两个服务共用） ----
# 留空的行不会写入远端 env 文件；直接改远端该文件也可即时生效（下次重启读取）
WIKI_JWT_SECRET=                     # JWT 签名密钥（必填，≥32 字节随机串，如 openssl rand -base64 48 生成）
WIKI_INTERNAL_KEY=                   # 后端与 collab-server 的共享密钥（用协同编辑则必填，两端自动一致）
WIKI_BASE_URL=                       # 前端可达地址，IM 推送链接前缀，如 https://wiki.example.com
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=                       # 企业微信群机器人 webhook，如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ---- 七牛云对象存储（附件/图片；留空项用 application.yml 默认值）----
# 不配置则回落本地磁盘存储（./data/uploads）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=                        # 默认 eflink
QINIU_DOMAIN=                        # 默认 https://oss.eflink.tech
QINIU_ZONE=                          # 默认 huanan（huadong/huabei/huanan/beimei/xinjiapo）
QINIU_PRIVATE_BUCKET=                # 默认 true：私有桶，服务端签名 URL
QINIU_WIKI_KEY_PREFIX=               # 默认 wiki/

# ---- eflink 主站关联登录（可选；全部留空 = 功能关闭）----
# secret 需与 eflink-backend 的 CONNECT_WIKI_SECRET 完全一致（openssl rand -hex 32 生成）
WIKI_EFLINK_LOGIN_ENABLED=           # true 开启登录页"eflink 账号登录"入口
WIKI_EFLINK_BASE_URL=                # 主站地址，默认 https://eflink.tech
WIKI_EFLINK_CONNECTOR_SECRET=       # 票据兑换共享密钥（必填才能开启）
WIKI_EFLINK_REDIRECT_BASE=           # 本 wiki 对外 Origin，如 https://wiki.eflink.tech，需与主站 connect.allowed-redirects 逐字一致
